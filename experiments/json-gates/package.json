{
  "name": "ldp-json-gates-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:integration": "node integration-build.mjs",
    "check:integration": "node --test --test-reporter=./redacted-reporter.mjs integration-artifacts.test.mjs",
    "browser:integration": "node run-integration-check.mjs",
    "test": "node --test --test-concurrency=1 --test-reporter=./redacted-reporter.mjs core.test.mjs deadline.test.mjs readiness-sw.test.mjs",
    "build:readiness": "node readiness-build.mjs",
    "check:readiness": "node --test --test-reporter=./redacted-reporter.mjs readiness-artifacts.test.mjs",
    "audit:security": "node ../../scripts/security-audit.mjs",
    "browser": "node browser-check.mjs",
    "serve": "node serve.mjs",
    "build": "node serve.mjs --build",
    "preview": "node serve.mjs --preview",
    "memory": "node memory-check.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
